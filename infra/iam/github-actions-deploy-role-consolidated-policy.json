{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTerraformIamRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::584047610071:role/*-axcloud-lab-lambda-ingest-role",
        "arn:aws:iam::584047610071:role/*-axcloud-lab-glue-shell-athena-exec-role"
      ]
    },
    {
      "Sid": "ManageTerraformInlinePoliciesForRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::584047610071:role/*-axcloud-lab-lambda-ingest-role",
        "arn:aws:iam::584047610071:role/*-axcloud-lab-glue-shell-athena-exec-role"
      ]
    },
    {
      "Sid": "ManageLambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:sa-east-1:584047610071:function:*-axcloud-lab-lambda-ingest"
    },
    {
      "Sid": "ManageGlueJobs",
      "Effect": "Allow",
      "Action": [
        "glue:CreateJob",
        "glue:DeleteJob",
        "glue:GetJob",
        "glue:TagResource",
        "glue:UntagResource",
        "glue:UpdateJob"
      ],
      "Resource": "arn:aws:glue:sa-east-1:584047610071:job/*-axcloud-lab-glue-shell-athena-exec"
    },
    {
      "Sid": "ManageSnsSubscriptions",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:SetSubscriptionAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSnsTopics",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:Publish",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:sa-east-1:584047610071:*-axcloud-lab-topic-ingest"
    },
    {
      "Sid": "ManageSqsQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageLambdaEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:ListEventSourceMappings",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageGlueLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:sa-east-1:584047610071:log-group:/aws-glue/jobs/*-axcloud-lab-glue-shell-athena-exec*"
    },
    {
      "Sid": "ManageDataBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:ListBucket",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::*-axcloud-lab-sa-east-1-data"
    }
  ]
}
